# Every response: no MIME sniffing, the address kept to this site, the headset and the microphone allowed only here.
# The content security policy is in report-only mode first (it logs what it would block, in the browser console):
# enforce it (rename to Content-Security-Policy) once a few sessions, multiplayer and VR included, show nothing blocked.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Permissions-Policy: xr-spatial-tracking=(self), microphone=(self), camera=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://assets.babylonjs.com https://raw.githubusercontent.com; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' data: blob: https://assets.babylonjs.com https://raw.githubusercontent.com https://0.peerjs.com wss://0.peerjs.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'none'

/manifest.webmanifest
  Content-Type: application/manifest+json

# Cloudflare static assets: the build's files carry a hash in their names, so a browser may keep them for good; the pages
# themselves are always checked for a newer version (a new release shows up on the next load, never a stale mix).
/bundle/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=604800
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
